LLM_PROVIDER=openai

OPENROUTER_API_KEY=
OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant-
GOOGLE_GENERATIVE_AI_API_KEY=

TELEGRAM_BOT_TOKEN=
# ⚠️ МИНИМУМ 16 СИМВОЛОВ. Если пустой или короткий — /api/telegram БУДЕТ ЗАКРЫТ (DENY).
# Используется как X-Telegram-Bot-Api-Secret-Token header (приоритет) или ?secret= query param (fallback).
# Устанавливается ОДНОВРЕМЕННО в setWebhook (secret_token) и тут.
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=

GOOGLE_APPS_SCRIPT_WEBHOOK=
# ⚠️ МИНИМУМ 16 СИМВОЛОВ. HMAC-SHA256 подпись payload (X-Signature: sha256=...).
# Web App в Apps Script ДОЛЖЕН проверять этот заголовок тем же секретом.
GOOGLE_SHEETS_SECRET=

# ⚠️ МИНИМУМ 16 СИМВОЛОВ. Если пустой или короткий — /api/bot/step БУДЕТ ЗАКРЫТ (DENY).
# Передавать в заголовке X-Salebot-Secret от клиента.
SALEBOT_SECRET=
